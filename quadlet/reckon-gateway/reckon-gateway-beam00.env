# Per-beam env for the catalogue reckon-gateway on beam00.lab (192.168.1.10).
#
# RELEASE_COOKIE is the BEAM's default cookie - irrelevant for
# clusters.eterm targets (per-peer cookies override) but must be set
# so the BEAM can register a name with epmd.

NODE_NAME=reckon_gateway@192.168.1.10
RELEASE_COOKIE=reckon_gateway_unused_default

RECKON_GATEWAY_PORT=50051
RECKON_GATEWAY_CLUSTERS_PATH=/etc/reckon-gateway/clusters.eterm
