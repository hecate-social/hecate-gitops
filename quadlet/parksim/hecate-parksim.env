# Per-beam env for hecate-parksim — single-tenant per container instance.
#
# Multi-tenancy is achieved by spinning up N container instances (one per
# tenant) with distinct TENANT_ID + NODE_NAME values. Each instance owns
# its own reckon-db store (parksim_<tenant_id>_store) and announces itself
# to the cluster-wide reckon_db_store_registry via pg, so reckon-gateway's
# catalogue mode sees every tenant's store across every beam.
#
# This file is the per-beam DEFAULT (one tenant per beam). For multi-tenant
# beams, duplicate the .container/.env pair with distinct TENANT_ID values
# and matching container names.

# Erlang node identity. NODE_NAME's left of @ must be unique on the node
# if multiple tenants run on the same beam (e.g. parksim_acme@..., parksim_burj@...).
NODE_NAME=parksim@192.168.1.13
RELEASE_COOKIE=tKcKQnLjuoAVECwP9TcfA2AQJvA6QzL4ZcnykOihzQw

INET_DIST_PORT_MIN=9100
INET_DIST_PORT_MAX=9100

HECATE_DATA_DIR=/data

# Tenant identity. Drives the store name (parksim_<TENANT_ID>_store) and
# the parksim aggregate's stream id (parksim-<TENANT_ID>).
TENANT_ID=demo

# Simulator knobs. Read by parksim's simulate_* apps at boot.
PARKSIM_SHAPE=city
PARKSIM_TIME_SCALE=1.0
PARKSIM_SEED=0

# Cluster seed-ping. Set to any beam-running parksim instance to form
# one Erlang cluster across all parksims. Leave empty for stand-alone.
HECATE_DIST_SEED=
