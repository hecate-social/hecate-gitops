# Per-beam env for hecate-parksim-entry2exit — TARGET: beam00.lab (192.168.1.10)
#
# RELEASE_COOKIE is shared with reckon-gateway and the sibling parksim
# apps; do not rotate without coordinating across all parksim/reckon
# nodes on the lab cluster.

NODE_NAME=parksim_entry2exit@192.168.1.10
RELEASE_COOKIE=tKcKQnLjuoAVECwP9TcfA2AQJvA6QzL4ZcnykOihzQw

# Pin the dist port range so the firewall hole is deterministic.
# Each parksim node uses port 9100 (it has its own beam = its own
# network namespace conceptually, even on host network).
INET_DIST_PORT_MIN=9100
INET_DIST_PORT_MAX=9100

# Data dir — /bulk0 per the beam-fleet HDD convention.
HECATE_DATA_DIR=/data

# Seed for the dist mesh: laptop reckon-gateway. Once any parksim
# pings it, transitive gossip mesh-connects all 9 nodes.
HECATE_DIST_SEED=reckon_gateway@192.168.1.100
