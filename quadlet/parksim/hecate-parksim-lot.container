[Unit]
Description=Hecate parksim — parking_lot lifecycle (CMD)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/hecate-services/hecate-parksim-lot:latest
ContainerName=hecate-parksim-lot
AutoUpdate=registry
Network=host

Volume=/bulk0/hecate-parksim-lot:/data:Z

PidsLimit=-1

EnvironmentFile=%h/.hecate/gitops/system/hecate-parksim-lot.env

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=60s

[Install]
WantedBy=default.target
