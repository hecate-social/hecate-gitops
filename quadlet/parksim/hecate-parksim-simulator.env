# Per-beam env for hecate-parksim-simulator — TARGET: beam03.lab (192.168.1.13)

NODE_NAME=parksim_simulator@192.168.1.13
RELEASE_COOKIE=tKcKQnLjuoAVECwP9TcfA2AQJvA6QzL4ZcnykOihzQw

INET_DIST_PORT_MIN=9100
INET_DIST_PORT_MAX=9100

HECATE_DATA_DIR=/data

HECATE_DIST_SEED=parksim_entry2exit@192.168.1.10

# Simulator-specific knobs. The simulator app reads these at boot
# from OS env (via parksim_simulator_config); not interpolated into
# sys.config.
PARKSIM_SHAPE=city
PARKSIM_TIME_SCALE=1.0
PARKSIM_SEED=0
PARKSIM_DRY_RUN=false
