[Unit]
Description=Hecate parksim — parking_rate + parking_permit lifecycle (CMD)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/hecate-services/hecate-parksim-pricing:latest
ContainerName=hecate-parksim-pricing
AutoUpdate=registry
Network=host

Volume=/bulk0/hecate-parksim-pricing:/data:Z

PidsLimit=-1

EnvironmentFile=%h/.hecate/gitops/system/hecate-parksim-pricing.env

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=60s

[Install]
WantedBy=default.target
